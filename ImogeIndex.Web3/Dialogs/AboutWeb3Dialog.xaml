<web3:Nuendow x:Class="ImogeIndex.Web3.Dialogs.AboutWeb3Dialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:web3="clr-namespace:ImogeIndex.Web3"
        xmlns:local="clr-namespace:ImogeIndex.Web3.Dialogs"
        xmlns:modelle="clr-namespace:ImogeIndex.Web3.Dialogs.Modelle"
        xmlns:web2="clr-namespace:ImogeIndex.Properties;assembly=ImogeIndex"
        mc:Ignorable="d"
        Foreground="{DynamicResource WindowForegroundBrush}"
        Background="{DynamicResource WindowBackgroundBrush}"              
        Title="{Binding WindowTitle}" MinHeight="300" Height="300" MinWidth="600" Width="600" WindowStartupLocation="CenterOwner" WindowStyle="ToolWindow">
    <Window.DataContext>
        <modelle:AboutWeb3DialogModelle/>
    </Window.DataContext>
    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <RowDefinition Height="100*"/>
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock FontSize="16" Text="{Binding ClientName}"/>
            <TextBlock FontSize="10" Text="{Binding Version}"/>
            <TextBlock>
                <Hyperlink NavigateUri="{Binding RepositoryUrl}" RequestNavigate="Hyperlink_RequestNavigate">
                    <Run Text="{Binding RepositoryUrl}"/>
                </Hyperlink>
            </TextBlock>
        </StackPanel>
        <DockPanel Grid.Row="1">
            <ListBox DockPanel.Dock="Left" ItemsSource="{Binding Documents}" DisplayMemberPath="Label" SelectedItem="{Binding SelectedDoc}" />
            <TextBox IsReadOnly="True" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" Text="{Binding SelectedDoc.Doc.Body}"/>
        </DockPanel>

    </Grid>
</web3:Nuendow>
