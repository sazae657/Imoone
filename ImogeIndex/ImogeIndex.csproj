<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>$(NetCoreAppWinTarget)</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <Platforms>x64</Platforms>
        <PublishReadyToRun>true</PublishReadyToRun>
        <PublishSingleFile>false</PublishSingleFile>
        <WindowsPackageType>None</WindowsPackageType>
        <AllowUnsafeBlocks>True</AllowUnsafeBlocks>
        <AssemblyVersion>$(NirVersion)</AssemblyVersion>
        <FileVersion>$(MurVersion)</FileVersion>
        <Version>$(MurVersion)</Version>
        <Product>ｲﾓｹﾞｲﾝﾃﾞｯｸｽ</Product>
        <PackageLicenseExpression>$(Muricense)</PackageLicenseExpression>
    </PropertyGroup>

    <ItemGroup Condition="'$(Platform)' == 'x64'">
        <PackageReference Include="Magick.NET-Q8-x64" />
    </ItemGroup>

    
    <!-- Surface買う気だったけど値上がりし過ぎで手が出ないのでやめ
    <ItemGroup Condition="'$(Platform)' == 'ARM64'">
        <PackageReference Include="Magick.NET-Q8-arm64" />
    </ItemGroup>
    -->

    <ItemGroup>
        <PackageReference Include="Magick.NET.Core" />
        <PackageReference Include="MetadataExtractor" />
        <PackageReference Include="Microsoft.WindowsAppSDK" />
        <PackageReference Include="ReadJEnc" />
        <PackageReference Include="Samboy063.Tomlet" />
        <PackageReference Include="SkiaSharp" />
        <PackageReference Include="System.Data.SQLite.Core" />
    </ItemGroup>

    <ItemGroup>
        <Compile Update="Properties\EmbedContents.Designer.cs">
          <DesignTime>True</DesignTime>
          <AutoGen>True</AutoGen>
          <DependentUpon>EmbedContents.resx</DependentUpon>
        </Compile>
        <Compile Update="Properties\Resources.Designer.cs">
            <DesignTime>True</DesignTime>
            <AutoGen>True</AutoGen>
            <DependentUpon>Resources.resx</DependentUpon>
        </Compile>
    </ItemGroup>

    <ItemGroup>
        <EmbeddedResource Update="Properties\EmbedContents.resx">
          <Generator>PublicResXFileCodeGenerator</Generator>
          <LastGenOutput>EmbedContents.Designer.cs</LastGenOutput>
        </EmbeddedResource>
        <EmbeddedResource Update="Properties\Resources.resx">
            <Generator>PublicResXFileCodeGenerator</Generator>
            <LastGenOutput>Resources.Designer.cs</LastGenOutput>
        </EmbeddedResource>
    </ItemGroup>

</Project>
