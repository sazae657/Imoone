<UserControl x:Class="ImogeIndexWPF.IncommingProgressBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root">
    <Border BorderBrush="{DynamicResource ControlBorderBrush}" BorderThickness="1" Margin="0,2,0,0">
        <Grid Margin="0,0,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <ProgressBar BorderThickness="0"
                         Value="{Binding Value, ElementName=Root, Mode=OneWay}"
                         Minimum="0"
                         Maximum="1.0"
                         MinHeight="4"
                         Margin="0"
                         Padding="0"
                         RenderTransformOrigin="0.5,0.5">
                <ProgressBar.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform ScaleX="-1"/>
                        <SkewTransform/>
                        <RotateTransform/>
                        <TranslateTransform/>
                    </TransformGroup>
                </ProgressBar.RenderTransform>
            </ProgressBar>
            <ProgressBar Grid.Column="1"
                         BorderThickness="0"
                         Value="{Binding Value, ElementName=Root, Mode=OneWay}"
                         Minimum="0"
                         Maximum="1.0"
                         MinHeight="4"
                         Padding="0"
                         Margin="0"/>
        </Grid>
    </Border>
</UserControl>
