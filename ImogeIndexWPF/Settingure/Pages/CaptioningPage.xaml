<UserControl x:Class="ImogeIndexWPF.Settingure.Pages.CaptioningPage"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
        xmlns:local="clr-namespace:ImogeIndexWPF.Settingure.Pages"
        xmlns:properties="clr-namespace:ImogeIndexWPF.Properties"
        mc:Ignorable="d" 
        d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Styles/ValidationStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition MinHeight="{StaticResource SMH}" Height="{StaticResource LA}"/>
                <RowDefinition MinHeight="{StaticResource SMH}" Height="{StaticResource LA}"/>
                <RowDefinition MinHeight="{StaticResource SMH}" Height="{StaticResource LA}"/>
                <RowDefinition MinHeight="{StaticResource SMH}" Height="{StaticResource LA}"/>
                <RowDefinition MinHeight="{StaticResource SMH}" Height="{StaticResource LA}"/>
                <RowDefinition MinHeight="{StaticResource SMH}" Height="{StaticResource LA}"/>
                <RowDefinition MinHeight="{StaticResource LMH}" Height="{StaticResource LA}"/>
                <RowDefinition MinHeight="{StaticResource LMH}" Height="{StaticResource LA}"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition MinWidth="60" Width="Auto"/>
                <ColumnDefinition Width="31*"/>
            </Grid.ColumnDefinitions>

            <TextBlock Text="{x:Static properties:Resources.SW_CapEnable}" Style="{StaticResource LabelOf}" />
            <CheckBox IsChecked="{Binding Enable, UpdateSourceTrigger=PropertyChanged}" 
                      Margin="{StaticResource SgrContentMargin}"
                      Grid.Column="1" />

            <TextBlock Grid.Row="1" Text="{x:Static properties:Resources.SW_CapLlmType}" Style="{StaticResource LabelOf}" />
            <ComboBox Grid.Row="1" ItemsSource="{Binding CaptionizerTypes}" 
                SelectedItem="{Binding Type}" 
                Margin="{StaticResource SgrContentMargin}"
                VerticalAlignment="Center"
                Grid.Column="1"/>

            <TextBlock Grid.Row="2" Text="{x:Static properties:Resources.SW_CapHttpTimeout}" Style="{StaticResource LabelOf}" />
            <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Vertical" Margin="{StaticResource SgrContentMargin}">
                <TextBox Text="{Binding HttpTimeout,
                    UpdateSourceTrigger=PropertyChanged,
                    ValidatesOnNotifyDataErrors=True}"/>
            </StackPanel>

            <TextBlock Grid.Row="3" Text="{x:Static properties:Resources.SW_CapAbortThreshold}" Style="{StaticResource LabelOf}" />
            <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Vertical" Margin="{StaticResource SgrContentMargin}">
                <TextBox Text="{Binding AbortThreshold,
                    UpdateSourceTrigger=PropertyChanged,
                    ValidatesOnNotifyDataErrors=True}"/>
            </StackPanel>

            <Separator Grid.Row="4" Grid.ColumnSpan="2" />

            <TextBlock Grid.Row="5" Text="{x:Static properties:Resources.SW_CapMoreHere}" Style="{StaticResource LabelOf}" />
            <StackPanel  Grid.Row="5" Grid.Column="1" Orientation="Vertical" Margin="{StaticResource SgrContentMargin}">
                <TextBox Style="{StaticResource MultiLineOf}"
                    Text="{Binding MoreHere,
                        UpdateSourceTrigger=PropertyChanged,
                        ValidatesOnNotifyDataErrors=True}"
                     />
            </StackPanel>

            <TextBlock Grid.Row="6" Text="{x:Static properties:Resources.SW_CapNoMoreHere}" Style="{StaticResource LabelOf}" />
            <StackPanel  Grid.Row="6" Grid.Column="1" Orientation="Vertical" Margin="{StaticResource SgrContentMargin}">
                <TextBox Style="{StaticResource MultiLineOf}"
                    Text="{Binding NoMoreHere,
                        UpdateSourceTrigger=PropertyChanged,
                        ValidatesOnNotifyDataErrors=True}"
                     />
            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
