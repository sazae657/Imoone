<UserControl x:Class="ImogeIndexWPF.Settingure.Pages.Captionizers.OpenAICompatPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:ImogeIndexWPF.Settingure.Pages.Captionizers"
             xmlns:properties="clr-namespace:ImogeIndexWPF.Properties"
             mc:Ignorable="d" 
             d:DesignHeight="800" d:DesignWidth="800">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Styles/ValidationStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition MinHeight="{StaticResource SMH}" Height="{StaticResource LA}"/>
                <RowDefinition MinHeight="{StaticResource SMH}" Height="{StaticResource LA}"/>
                <RowDefinition MinHeight="{StaticResource SMH}" Height="{StaticResource LA}"/>
                <RowDefinition MinHeight="{StaticResource SMH}" Height="{StaticResource LA}"/>
                <RowDefinition MinHeight="{StaticResource SMH}" Height="{StaticResource LA}"/>
                <RowDefinition MinHeight="{StaticResource SMH}" Height="{StaticResource LA}"/>
                <RowDefinition MinHeight="{StaticResource SMH}" Height="{StaticResource LA}"/>
                <RowDefinition MinHeight="{StaticResource SMH}" Height="{StaticResource LA}"/>
                <RowDefinition MinHeight="{StaticResource SMH}" Height="{StaticResource LA}"/>
                <RowDefinition MinHeight="{StaticResource SMH}" Height="{StaticResource LA}"/>
                <RowDefinition MinHeight="{StaticResource SMH}" Height="{StaticResource LA}"/>
                <RowDefinition MinHeight="{StaticResource SMH}" Height="{StaticResource LA}"/>
                <RowDefinition MinHeight="{StaticResource SMH}" Height="{StaticResource LA}"/>
                <RowDefinition MinHeight="{StaticResource LMH}" Height="{StaticResource LA}"/>
                <RowDefinition MinHeight="{StaticResource SMH}" Height="{StaticResource LA}"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition MinWidth="100" Width="Auto"/>
                <ColumnDefinition Width="31*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="{x:Static properties:Resources.SW_CapUrl}" Style="{StaticResource LabelOf}" />
            <StackPanel Grid.Column="1" Orientation="Vertical" Margin="{StaticResource SgrContentMargin}">
                <TextBox Text="{Binding Host,
                    UpdateSourceTrigger=PropertyChanged,
                    ValidatesOnNotifyDataErrors=True}" />
            </StackPanel>
            <TextBlock Grid.Row="1" Text="{x:Static properties:Resources.SW_CapApiKey}" Style="{StaticResource LabelOf}" />
            <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Vertical" Margin="{StaticResource SgrContentMargin}">
                <TextBox Text="{Binding ApiKey,
                    UpdateSourceTrigger=PropertyChanged,
                    ValidatesOnNotifyDataErrors=True}" />
            </StackPanel>

            <TextBlock Grid.Row="2" Text="{x:Static properties:Resources.SW_CapModel}" Style="{StaticResource LabelOf}" />
            <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Vertical" Margin="{StaticResource SgrContentMargin}">
                <TextBox Text="{Binding Model,
                    UpdateSourceTrigger=PropertyChanged,
                    ValidatesOnNotifyDataErrors=True}" />
            </StackPanel>

            <TextBlock Grid.Row="3" Text="{x:Static properties:Resources.SW_CapImageSize}" Style="{StaticResource LabelOf}" />
            <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Vertical" Margin="{StaticResource SgrContentMargin}">
                <TextBox Text="{Binding ImageSize,
                    UpdateSourceTrigger=PropertyChanged,
                    ValidatesOnNotifyDataErrors=True}" />
            </StackPanel>

            <TextBlock Grid.Row="4" Text="{x:Static properties:Resources.SW_CapRetry}" Style="{StaticResource LabelOf}" />
            <StackPanel Grid.Row="4" Grid.Column="1" Orientation="Vertical" Margin="{StaticResource SgrContentMargin}">
                <TextBox Text="{Binding Retry,
                    UpdateSourceTrigger=PropertyChanged,
                    ValidatesOnNotifyDataErrors=True}" />
            </StackPanel>

            <Separator Grid.Row="5" Grid.ColumnSpan="2" />

            <TextBlock Grid.Row="6" Text="{x:Static properties:Resources.SW_CapLlm_Temperature}" Style="{StaticResource LabelOf}" />
            <StackPanel Grid.Row="6" Grid.Column="1" Orientation="Vertical" Margin="{StaticResource SgrContentMargin}">
                <TextBox Text="{Binding Temperature,
                    UpdateSourceTrigger=LostFocus,
                    ValidatesOnNotifyDataErrors=True}"/>
            </StackPanel>

            <TextBlock Grid.Row="7" Text="{x:Static properties:Resources.SW_CapLlm_TopP}" Style="{StaticResource LabelOf}" />
            <StackPanel Grid.Row="7" Grid.Column="1" Orientation="Vertical" Margin="{StaticResource SgrContentMargin}">
                <TextBox Text="{Binding TopP,
                       UpdateSourceTrigger=LostFocus,
                       ValidatesOnNotifyDataErrors=True}"/>
            </StackPanel>

            <TextBlock Grid.Row="8" Text="{x:Static properties:Resources.SW_CapLlm_TopK}" Style="{StaticResource LabelOf}" />
            <StackPanel Grid.Row="8" Grid.Column="1" Orientation="Vertical" Margin="{StaticResource SgrContentMargin}">
                <TextBox Text="{Binding TopK,
                        UpdateSourceTrigger=LostFocus,
                        ValidatesOnNotifyDataErrors=True}"/>
            </StackPanel>

            <TextBlock Grid.Row="9" Text="{x:Static properties:Resources.SW_CapLlm_RepeatPenalty}" Style="{StaticResource LabelOf}" />
            <StackPanel Grid.Row="9" Grid.Column="1" Orientation="Vertical" Margin="{StaticResource SgrContentMargin}">
                <TextBox Text="{Binding RepeatPenalty,
                       UpdateSourceTrigger=LostFocus,
                       ValidatesOnNotifyDataErrors=True}"/>
            </StackPanel>

            <TextBlock Grid.Row="10" Text="{x:Static properties:Resources.SW_CapLlm_MaxTokens}" Style="{StaticResource LabelOf}" />
            <StackPanel Grid.Row="10" Grid.Column="1" Orientation="Vertical" Margin="{StaticResource SgrContentMargin}">
                <TextBox Text="{Binding MaxTokens,
                        UpdateSourceTrigger=LostFocus,
                        ValidatesOnNotifyDataErrors=True}"/>
            </StackPanel>

            <!-- プロンプトのオーバーライド -->
            <Separator Grid.Row="11" Grid.ColumnSpan="2" />
            <TextBlock Grid.Row="12" Text="{x:Static properties:Resources.SW_CapLlm_UseCustomPrompt}" Style="{StaticResource LabelOf}" />
            <CheckBox Grid.Row="12" 
                IsChecked="{Binding UseCustomPrompt}" 
                Margin="{StaticResource SgrContentMargin}" Grid.Column="1"/>

            <TextBlock Grid.Row="13" Text="{x:Static properties:Resources.SW_CapLlm_CustomPrompt}" Style="{StaticResource LabelOf}" />
            <StackPanel Grid.Row="13"  Grid.Column="1" Orientation="Vertical" Margin="{StaticResource SgrContentMargin}">
                <TextBox Style="{StaticResource MultiLineOf}"
                    Text="{Binding CustomPrompt,
                       UpdateSourceTrigger=PropertyChanged,
                       ValidatesOnNotifyDataErrors=True}"
                    IsEnabled="{Binding UseCustomPrompt}"     
                    AcceptsReturn="True"/>
            </StackPanel>
        </Grid>
    </ScrollViewer>

</UserControl>
