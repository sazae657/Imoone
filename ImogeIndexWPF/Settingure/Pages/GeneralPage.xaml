<UserControl x:Class="ImogeIndexWPF.Settingure.Pages.GeneralPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:ImogeIndexWPF.Settingure.Pages"
      xmlns:sys="clr-namespace:System;assembly=mscorlib"
      xmlns:properties="clr-namespace:ImogeIndexWPF.Properties"
      mc:Ignorable="d" 
      d:DesignHeight="800" d:DesignWidth="800">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Styles/ValidationStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition MinHeight="{StaticResource LMH}" Height="{StaticResource LA}"/>
                <RowDefinition MinHeight="{StaticResource LMH}" Height="{StaticResource LA}"/>
                <RowDefinition MinHeight="{StaticResource LMH}" Height="{StaticResource LA}"/>
                <RowDefinition MinHeight="{StaticResource SMH}" Height="{StaticResource LA}"/>
                <RowDefinition MinHeight="{StaticResource SMH}" Height="{StaticResource LA}"/>
                <RowDefinition MinHeight="{StaticResource SMH}" Height="{StaticResource LA}"/>
                <RowDefinition MinHeight="{StaticResource SMH}" Height="{StaticResource LA}"/>
                <RowDefinition MinHeight="{StaticResource SMH}" Height="{StaticResource LA}"/>
                <RowDefinition MinHeight="{StaticResource SMH}" Height="{StaticResource LA}"/>
                <RowDefinition MinHeight="{StaticResource SMH}" Height="{StaticResource LA}"/>
                <RowDefinition MinHeight="{StaticResource SMH}" Height="{StaticResource LA}"/>
                <RowDefinition MinHeight="{StaticResource SMH}" Height="{StaticResource LA}"/>
                <RowDefinition MinHeight="{StaticResource LMH}" Height="{StaticResource LA}"/>
                <RowDefinition MinHeight="{StaticResource SMH}" Height="{StaticResource LA}"/>
                <RowDefinition MinHeight="{StaticResource SMH}" Height="{StaticResource LA}"/>
                <RowDefinition MinHeight="{StaticResource SMH}" Height="{StaticResource LA}"/>
                <RowDefinition MinHeight="{StaticResource SMH}" Height="{StaticResource LA}"/>

            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition MinWidth="100" Width="Auto"/>
                <ColumnDefinition Width="31*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="{x:Static properties:Resources.SW_SearchPath}" Style="{StaticResource LabelOf}" />
            <StackPanel Grid.Column="1" Orientation="Vertical" Margin="{StaticResource SgrContentMargin}">
                <TextBox Style="{StaticResource MultiLineOf}"
                    Text="{Binding SearchPaths,
                        UpdateSourceTrigger=PropertyChanged,
                        ValidatesOnNotifyDataErrors=True}"/>
            </StackPanel>

            <TextBlock Grid.Row="1" Text="{x:Static properties:Resources.SW_ExcludePath}" Style="{StaticResource LabelOf}" />
            <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Vertical" Margin="{StaticResource SgrContentMargin}">
                <TextBox Style="{StaticResource MultiLineOf}"
                    Text="{Binding ExcludePaths,
                        UpdateSourceTrigger=PropertyChanged,
                        ValidatesOnNotifyDataErrors=True}"/>
            </StackPanel>

            <TextBlock Grid.Row="2" Text="{x:Static properties:Resources.SW_ExcludePattern}" Style="{StaticResource LabelOf}" />
            <StackPanel  Grid.Row="2" Grid.Column="1" Orientation="Vertical" Margin="{StaticResource SgrContentMargin}">
                <TextBox Style="{StaticResource MultiLineOf}"
                    Text="{Binding ExcludePatterns,
                        UpdateSourceTrigger=PropertyChanged,
                        ValidatesOnNotifyDataErrors=True}"
                     />
            </StackPanel>

            <TextBlock Grid.Row="3" Text="{x:Static properties:Resources.SW_ImageExtension}" Style="{StaticResource LabelOf}" />
            <StackPanel  Grid.Row="3" Grid.Column="1" Orientation="Vertical" Margin="{StaticResource SgrContentMargin}">
                <TextBox
                     Text="{Binding ImageExtsnsions,
                        UpdateSourceTrigger=PropertyChanged,
                        ValidatesOnNotifyDataErrors=True}"/>
            </StackPanel>

            <TextBlock Grid.Row="4" Text="{x:Static properties:Resources.SW_CacheDir}" Style="{StaticResource LabelOf}" />
            <StackPanel  Grid.Row="4" Grid.Column="1" Orientation="Vertical" Margin="{StaticResource SgrContentMargin}">
                <TextBox Text="{Binding CacheDir,
                        UpdateSourceTrigger=PropertyChanged,
                        ValidatesOnNotifyDataErrors=True}"/>
            </StackPanel>

            <TextBlock Grid.Row="5" Text="{x:Static properties:Resources.SW_Threads}" Style="{StaticResource LabelOf}" />
            <StackPanel Grid.Row="5" Grid.Column="1" Orientation="Vertical" Margin="{StaticResource SgrContentMargin}">
                <TextBox Text="{Binding Threads,
                        UpdateSourceTrigger=PropertyChanged,
                        ValidatesOnNotifyDataErrors=True}"/>
            </StackPanel>

            <TextBlock Grid.Row="6" Text="{x:Static properties:Resources.SW_BuffersPerThread}" Style="{StaticResource LabelOf}" />
            <StackPanel Grid.Row="6" Grid.Column="1" Orientation="Vertical" Margin="{StaticResource SgrContentMargin}">
                <TextBox Text="{Binding BufferCount,
                        UpdateSourceTrigger=PropertyChanged,
                        ValidatesOnNotifyDataErrors=True}"/>
            </StackPanel>            

            <Separator Grid.Row="7" Grid.ColumnSpan="2" />

            <TextBlock Grid.Row="8" Text="{x:Static properties:Resources.SW_EnableThumbnail}" Style="{StaticResource LabelOf}" />
            <CheckBox Grid.Row="8"
                IsChecked="{Binding EnableThumbnail}" 
                Margin="{StaticResource SgrContentMargin}" Grid.Column="1"/>

            <TextBlock Grid.Row="9" Text="{x:Static properties:Resources.SW_ThumbnailSize}" Style="{StaticResource LabelOf}" />
            <StackPanel Grid.Row="9" Grid.Column="1" Orientation="Vertical" Margin="{StaticResource SgrContentMargin}">
                <TextBox Text="{Binding ThumbnailSize,
                        UpdateSourceTrigger=PropertyChanged,
                        ValidatesOnNotifyDataErrors=True}"
                    IsEnabled="{Binding EnableThumbnail}"/>
            </StackPanel>

            <Separator Grid.Row="10" Grid.ColumnSpan="2" />

            <TextBlock Grid.Row="11" Text="{x:Static properties:Resources.SW_LogLevel}" Style="{StaticResource LabelOf}" />
            <StackPanel Grid.Row="11" Grid.Column="1" Orientation="Vertical" Margin="{StaticResource SgrContentMargin}">
                <TextBox Text="{Binding LogLevel,
                        UpdateSourceTrigger=PropertyChanged,
                        ValidatesOnNotifyDataErrors=True}"/>
            </StackPanel>

            <TextBlock Grid.Row="12" Text="{x:Static properties:Resources.SW_MetadatumSearchTags}" Style="{StaticResource LabelOf}" />
            <StackPanel Grid.Row="12" Grid.Column="1" Orientation="Vertical" Margin="{StaticResource SgrContentMargin}">
                <TextBox Style="{StaticResource MultiLineOf}"
                    Text="{Binding MetadataSearchTags,
                        UpdateSourceTrigger=PropertyChanged,
                        ValidatesOnNotifyDataErrors=True}"/>
                <TextBlock Text="model:text=Model / iso:number=ISO Speed Ratings / exposure:number=Exposure Time"
                    TextWrapping="Wrap" Margin="0,4,0,0" />
            </StackPanel>

            <Separator Grid.Row="13" Grid.ColumnSpan="2" />

            <TextBlock Grid.Row="14" Text="{x:Static properties:Resources.SW_NiractionEnable}" Style="{StaticResource LabelOf}" />
            <CheckBox Grid.Row="14"
                IsChecked="{Binding NiractionEnabled}"
                VerticalAlignment="Center"
                Margin="{StaticResource SgrContentMargin}"
                Grid.Column="1" />
            
            <TextBlock Grid.Row="15" Text="{x:Static properties:Resources.SW_NiractionHost}" Style="{StaticResource LabelOf}" />
            <StackPanel Grid.Row="15" Grid.Column="1" Orientation="Vertical" Margin="{StaticResource SgrContentMargin}">
                <TextBox IsEnabled="{Binding NiractionEnabled}" Text="{Binding NiractionHost,
                        UpdateSourceTrigger=PropertyChanged,
                        ValidatesOnNotifyDataErrors=True}"/>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
