<UserControl x:Class="ImogeIndexWPF.Settingure.Pages.TaggerPage"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
        xmlns:local="clr-namespace:ImogeIndexWPF.Settingure.Pages"
        xmlns:properties="clr-namespace:ImogeIndexWPF.Properties"
        mc:Ignorable="d" 
        d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Styles/ValidationStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition MinHeight="{StaticResource SMH}" Height="{StaticResource LA}"/>
                <RowDefinition MinHeight="{StaticResource SMH}" Height="{StaticResource LA}"/>
                <RowDefinition MinHeight="{StaticResource SMH}" Height="{StaticResource LA}"/>
                <RowDefinition MinHeight="{StaticResource SMH}" Height="{StaticResource LA}"/>
                <RowDefinition MinHeight="{StaticResource SMH}" Height="{StaticResource LA}"/>
                <RowDefinition MinHeight="{StaticResource SMH}" Height="{StaticResource LA}"/>
                <RowDefinition MinHeight="{StaticResource SMH}" Height="{StaticResource LA}"/>
                <RowDefinition MinHeight="{StaticResource SMH}" Height="{StaticResource LA}"/>
                <RowDefinition MinHeight="{StaticResource SMH}" Height="{StaticResource LA}"/>
                <RowDefinition MinHeight="{StaticResource SMH}" Height="{StaticResource LA}"/>
                <RowDefinition MinHeight="{StaticResource SMH}" Height="{StaticResource LA}"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition MinWidth="100" Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="{x:Static properties:Resources.SW_TaggerEnable}" Style="{StaticResource LabelOf}" />
            <CheckBox IsChecked="{Binding Enable, UpdateSourceTrigger=PropertyChanged}" Margin="{StaticResource SgrContentMargin}" Grid.Column="1" />

            <TextBlock Grid.Row="1" Text="{x:Static properties:Resources.SW_TaggerType}" Style="{StaticResource LabelOf}" />
            <ComboBox Grid.Row="1" ItemsSource="{Binding TaggerTypes}" 
                SelectedItem="{Binding TaggerType}" 
                IsEnabled="{Binding Enable}"
                VerticalAlignment="Center"
                Margin="{StaticResource SgrContentMargin}"
                Grid.Column="1" />

            <TextBlock Grid.Row="2" Text="{x:Static properties:Resources.SW_TaggerModel}" Style="{StaticResource LabelOf}" />
            <Grid Grid.Row="2" Grid.Column="1" Margin="{StaticResource SgrContentMargin}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox x:Name="ModelTextBox" Text="{Binding Model,
                        UpdateSourceTrigger=PropertyChanged,
                        ValidatesOnNotifyDataErrors=True}"
                    IsEnabled="{Binding Enable}" />
                <Button Grid.Column="1" Content="{x:Static properties:Resources.SG_OpenDialogW}" Margin="4,0,0,0" Padding="6,1,6,1"
                        VerticalAlignment="Top" IsEnabled="{Binding Enable}"
                        Command="{Binding OpenModelFileCommand}" />
            </Grid>

            <TextBlock Grid.Row="3" Text="{x:Static properties:Resources.SW_TaggerTags}" Style="{StaticResource LabelOf}" />
            <Grid Grid.Row="3" Grid.Column="1" Margin="{StaticResource SgrContentMargin}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox Text="{Binding Tags,
                        UpdateSourceTrigger=PropertyChanged,
                        ValidatesOnNotifyDataErrors=True}"
                    IsEnabled="{Binding Enable}" />
                <Button Grid.Column="1" Content="{x:Static properties:Resources.SG_OpenDialogW}" Margin="4,0,0,0" Padding="6,1,6,1"
                        VerticalAlignment="Top" IsEnabled="{Binding Enable}"
                        Command="{Binding OpenTagFileCommand}" />
            </Grid>


            <TextBlock Grid.Row="4" Text="{x:Static properties:Resources.SG_Cap_Modepile}" Style="{StaticResource LabelOf}" />
            <CheckBox Grid.Row="4" IsChecked="{Binding Modepile, UpdateSourceTrigger=PropertyChanged}" Margin="{StaticResource SgrContentMargin}" Grid.Column="1" />

            <TextBlock Grid.Row="5" Text="{x:Static properties:Resources.SW_TaggerDevicePolicy}" Style="{StaticResource LabelOf}" />
            <ComboBox Grid.Row="5" ItemsSource="{Binding DevicePolicyOf}" 
                SelectedItem="{Binding DevicePolicy}" 
                IsEnabled="{Binding Enable}"
                VerticalAlignment="Center"
                Margin="{StaticResource SgrContentMargin}"
                Grid.Column="1"/>

            <TextBlock Grid.Row="6" Text="{x:Static properties:Resources.SW_TaggerThreshold}" Style="{StaticResource LabelOf}" />
            <StackPanel Grid.Row="6" Grid.Column="1" Orientation="Vertical" Margin="{StaticResource SgrContentMargin}">
                <TextBox Text="{Binding Threshold,
                            UpdateSourceTrigger=LostFocus,
                            ValidatesOnNotifyDataErrors=True}"
                    IsEnabled="{Binding Enable}" />
            </StackPanel>

            <TextBlock Grid.Row="7" Text="{x:Static properties:Resources.SW_TaggerCharacterThreshold}" Style="{StaticResource LabelOf}" />
            <StackPanel Grid.Row="7" Grid.Column="1" Orientation="Vertical" Margin="{StaticResource SgrContentMargin}">
                <TextBox Text="{Binding CharacterThreshold,
                        UpdateSourceTrigger=LostFocus,
                        ValidatesOnNotifyDataErrors=True}"
                    IsEnabled="{Binding Enable}"/>
            </StackPanel>

            <TextBlock Grid.Row="8" Text="{x:Static properties:Resources.SW_TaggerThreads}" Style="{StaticResource LabelOf}" />
            <StackPanel Grid.Row="8" Grid.Column="1" Orientation="Vertical" Margin="{StaticResource SgrContentMargin}">
                <TextBox Text="{Binding Threads,
                        UpdateSourceTrigger=PropertyChanged,
                        ValidatesOnNotifyDataErrors=True}"
                    IsEnabled="{Binding Enable}" />
            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
