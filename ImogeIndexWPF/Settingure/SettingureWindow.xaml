<shared:Nuendow x:Class="ImogeIndexWPF.Settingure.SettingureWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:shared="clr-namespace:ImogeIndex.Web3;assembly=ImogeIndex.Web3"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ImogeIndexWPF.Settingure"
        xmlns:normPages="clr-namespace:ImogeIndexWPF.Settingure.Modelle.Pages"
        xmlns:captPages="clr-namespace:ImogeIndexWPF.Settingure.Modelle.Pages.Captionizers"
        xmlns:pages="clr-namespace:ImogeIndexWPF.Settingure.Pages"
        xmlns:capts="clr-namespace:ImogeIndexWPF.Settingure.Pages.Captionizers"
        xmlns:properties="clr-namespace:ImogeIndexWPF.Properties"
        Background="{DynamicResource WindowBackgroundBrush}" mc:Ignorable="d" Foreground="{DynamicResource WindowForegroundBrush}"
        Title="{Binding SettingureTitle}" Height="450" Width="800" WindowStyle="ToolWindow"
        TextBoxBase.TextChanged="OnTextChanged"
        local:BindingErrorPoliticalOfficer.ErrorChanged="OnBindingErrorChanged">
    <shared:Nuendow.Resources>
        <DataTemplate DataType="{x:Type normPages:GeneralPageModell}">
            <pages:GeneralPage />
        </DataTemplate>

        <DataTemplate DataType="{x:Type normPages:TaggerPageModell}">
            <pages:TaggerPage />
        </DataTemplate>

        <DataTemplate DataType="{x:Type normPages:CaptioningPageModell}">
            <pages:CaptioningPage />
        </DataTemplate>

        <DataTemplate DataType="{x:Type captPages:OllamaPageModell}">
            <capts:OllamaPage />
        </DataTemplate>
        <DataTemplate DataType="{x:Type captPages:LlamaCppPageModell}">
            <capts:LLamaCppPage />
        </DataTemplate>
        <DataTemplate DataType="{x:Type captPages:OpenAICompatPageModell}">
            <capts:OpenAICompatPage />
        </DataTemplate>
        
        <!-- グループ指定 -->
        <CollectionViewSource x:Key="Kwategory" Source="{Binding Categories}" >
            <CollectionViewSource.GroupDescriptions>
                <PropertyGroupDescription PropertyName="Group"/>
            </CollectionViewSource.GroupDescriptions>
        </CollectionViewSource>

        <!-- グループヘッダー -->
        <DataTemplate x:Key="GroupHeaderTemplate">
            <Border Background="{DynamicResource HeaderBackgroundBrush}">
                <TextBlock Text="{Binding Name}"  FontWeight="Bold" Foreground="{DynamicResource HeaderForegroundBrush}"/>
            </Border>
        </DataTemplate>
    </shared:Nuendow.Resources>
    <DockPanel>
        <!-- 全ページ共通ボタン -->
        <Border
            Grid.Row="1"
            Padding="12,12,0,12"
            BorderThickness="0,1,0,0"
            BorderBrush="{DynamicResource ControlBorderBrush}"
            DockPanel.Dock="Bottom">

            <StackPanel
                HorizontalAlignment="Right"
                Orientation="Horizontal">

                <Button
                    MinWidth="90"
                    Margin="0,0,8,0"
                    Content="{x:Static properties:Resources.IDM_SAVE}"
                    Command="{Binding OkCommand}" />

                <Button
                    MinWidth="90"
                    Margin="0,0,8,0"
                    IsEnabled="{Binding Session.CanApply}"
                    Content="{x:Static properties:Resources.IDM_APPLY}"
                    Command="{Binding ApplyCommand}" />

                <Button
                    MinWidth="90"
                    Margin="0,0,8,0"
                    Content="{x:Static properties:Resources.IDM_CANCEL}"
                    Command="{Binding CancelCommand}"
                    IsCancel="True" />
            </StackPanel>
        </Border>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="167" MinWidth="160"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 左ペイン -->
            <DockPanel>
                <ListView ItemsSource="{Binding Source={StaticResource Kwategory}}" 
                          SelectedIndex="{Binding SelectedIndex}" 
                          SelectionChanged="ListView_SelectionChanged" >
                    <ListView.GroupStyle>
                        <GroupStyle HeaderTemplate="{StaticResource GroupHeaderTemplate}" />
                    </ListView.GroupStyle>

                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Title}" />
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </DockPanel>

            <GridSplitter Grid.Column="1"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    ResizeDirection="Columns" />

            <DockPanel Grid.Column="2">
                <Border DockPanel.Dock="Top" Margin="0,0,0,4" Background="{DynamicResource HeaderBackgroundBrush}">
                    <TextBlock Text="{Binding PageTitle}" Foreground="{DynamicResource HeaderForegroundBrush}" Margin="4"/>
                </Border>
                <!-- 右ペイン -->
                <ContentControl
                    Margin="8,8,8,8"
                    Content="{Binding CurrentPage}" />
            </DockPanel>
        </Grid>

    </DockPanel>
</shared:Nuendow>
