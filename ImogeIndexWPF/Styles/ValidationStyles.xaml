<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib"
                    xmlns:settingure="clr-namespace:ImogeIndexWPF.Settingure"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <GridLength x:Key="LA">Auto</GridLength>
    <GridLength x:Key="LH">80</GridLength>
    <sys:Double x:Key="LMH">40</sys:Double>
    <GridLength x:Key="RH">40</GridLength>
    <sys:Double x:Key="RMH">40</sys:Double>
    <sys:Double x:Key="SMH">30</sys:Double>
    <Thickness x:Key="DefaultMargin">0,8,0,8</Thickness>
    <Thickness x:Key="SgrContentMargin">16,4,4,4</Thickness>
    <Style TargetType="TextBlock">
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style TargetType="CheckBox" BasedOn="{StaticResource ThemeCheckBoxStyle}">
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    
    <Style x:Key="LabelOf" TargetType="TextBlock">
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="TextAlignment" Value="Left" />
    </Style>


    <!-- エラーメッセージ -->
    <Style x:Key="Validatable" TargetType="TextBox" BasedOn="{StaticResource ThemeTextBoxStyle}">
        <Setter Property="settingure:BindingErrorPoliticalOfficer.Enabled" Value="True" />
        <Setter Property="Validation.ErrorTemplate">
            <Setter.Value>
                <ControlTemplate>
                    <StackPanel>
                        <AdornedElementPlaceholder x:Name="customAdorner" />
                        <TextBlock Text="{Binding ElementName=customAdorner, Path=AdornedElement.(Validation.Errors)[0].ErrorContent}"
                                   Foreground="Red"
                                   FontSize="12"
                                   Margin="0,2,0,0"  />
                    </StackPanel>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <!-- テキストボックスの枠線を赤くするトリガー -->
        <Style.Triggers>
            <Trigger Property="Validation.HasError" Value="False">
                <Setter Property="Margin" Value="0,0,0,0"/>
            </Trigger>
            <Trigger Property="Validation.HasError" Value="True">
                <Setter Property="Margin" Value="0,0,0,20"/>
                <Setter Property="BorderBrush" Value="Red"/>
                <Setter Property="BorderThickness" Value="1"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="MultiLineOf" TargetType="TextBox" BasedOn="{StaticResource Validatable}">
        <Setter Property="AcceptsReturn" Value="True" />
        <Setter Property="MinLines" Value="2" />
    </Style>

    <Style TargetType="TextBox" BasedOn="{StaticResource Validatable}">
    </Style>

</ResourceDictionary>
