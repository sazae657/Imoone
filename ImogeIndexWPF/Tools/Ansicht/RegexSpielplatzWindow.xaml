<shared:Nuendow x:Class="ImogeIndexWPF.Tools.Ansicht.RegexSpielplatzWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:shared="clr-namespace:ImogeIndex.Web3;assembly=ImogeIndex.Web3"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ImogeIndexWPF.Tools.Ansicht"
        xmlns:modelle="clr-namespace:ImogeIndexWPF.Tools.Modelle"
        xmlns:properties="clr-namespace:ImogeIndexWPF.Properties"
        Background="{DynamicResource WindowBackgroundBrush}" mc:Ignorable="d" Foreground="{DynamicResource WindowForegroundBrush}"
        Title="{x:Static properties:Resources.SG_T_RegexSandbox}" Height="450" Width="800">
    <shared:Nuendow.DataContext>
        <modelle:RegexSpielplatzModelle/>
    </shared:Nuendow.DataContext>
    <shared:Nuendow.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Styles/ValidationStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </shared:Nuendow.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="8">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition MinHeight="{StaticResource SMH}" Height="{StaticResource LA}"/>
                <RowDefinition MinHeight="{StaticResource SMH}" Height="{StaticResource LA}"/>
                <RowDefinition MinHeight="{StaticResource SMH}" Height="{StaticResource LA}"/>
                <RowDefinition MinHeight="{StaticResource SMH}" Height="{StaticResource LA}"/>
                <RowDefinition Height="128*"/>
                <RowDefinition Height="128*"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition MinWidth="100" Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <TextBlock Text="{x:Static properties:Resources.SG_T_Regex}" Style="{StaticResource LabelOf}" />
            <TextBox AcceptsReturn="True" 
                     Text="{Binding Regex, UpdateSourceTrigger=PropertyChanged}"
                     Margin="{StaticResource SgrContentMargin}" Grid.Column="1"/>

            <TextBlock Grid.Row="1" Text="{x:Static properties:Resources.SG_T_Text}" Style="{StaticResource LabelOf}" />
            <TextBox Grid.Row="1"                     
                     AcceptsReturn="True" 
                     Text="{Binding TestString, UpdateSourceTrigger=PropertyChanged}"
                     Margin="{StaticResource SgrContentMargin}" Grid.Column="1"/>

            <TextBlock Grid.Row="2" Text="{x:Static properties:Resources.SG_T_IgnoreCase}" Style="{StaticResource LabelOf}" />
            <CheckBox Grid.Row="2"                     
                     IsChecked="{Binding IgnoreCase}"
                     Margin="{StaticResource SgrContentMargin}" Grid.Column="1"/>            

            <Separator Grid.Row="3" Grid.ColumnSpan="2"/>


            <TextBlock Grid.Row="4" Text="{x:Static properties:Resources.SG_T_Result}" Style="{StaticResource LabelOf}" />
            <RichTextBox x:Name="editField" Grid.Row="4" AcceptsReturn="True" IsReadOnly="True" 
                         Margin="{StaticResource SgrContentMargin}" Grid.Column="1"/>


            <TextBlock Grid.Row="5" Text="{x:Static properties:Resources.SG_T_Groups}" Style="{StaticResource LabelOf}" />
            <ListView x:Name="LustView" Grid.Row="5" Grid.Column="1" ItemsSource="{Binding Results}" Margin="{StaticResource SgrContentMargin}">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="{x:Static properties:Resources.SG_T_Group}" Width="Auto" DisplayMemberBinding="{Binding Group}"/>
                        <GridViewColumn Header="{x:Static properties:Resources.SG_T_Index}" Width="Auto" DisplayMemberBinding="{Binding Index}"/>
                        <GridViewColumn Header="{x:Static properties:Resources.SG_T_Value}" Width="Auto" DisplayMemberBinding="{Binding Value}"/>
                    </GridView>
                </ListView.View>
            </ListView>
        </Grid>

    </ScrollViewer>
</shared:Nuendow>
