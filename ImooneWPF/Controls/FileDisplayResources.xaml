<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:controls="clr-namespace:ImooneWPF.Controls">
    <!-- アイコン表示のぱねる(寸法は一覧に付けたTileMetricsから貰う) -->
    <ItemsPanelTemplate x:Key="TilePanel">
        <controls:EssenUndFressenPanel
            ItemWidth="{Binding (controls:TileMetrics.ItemWidth), RelativeSource={RelativeSource AncestorType=ListView}}"
            ItemHeight="{Binding (controls:TileMetrics.ItemHeight), RelativeSource={RelativeSource AncestorType=ListView}}"/>
    </ItemsPanelTemplate>
    <!-- 小アイコン(名前は右) -->
    <DataTemplate x:Key="TileTemplateHorizontal">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <controls:Rubbernail Item="{Binding}" Margin="0,0,6,0"
                                 Width="{Binding (controls:TileMetrics.IconSize), RelativeSource={RelativeSource AncestorType=ListView}}"
                                 Height="{Binding (controls:TileMetrics.IconSize), RelativeSource={RelativeSource AncestorType=ListView}}"/>
            <TextBlock Grid.Column="1" Text="{Binding Name}" ToolTip="{Binding Name}"
                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListViewItem}}"
                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
        </Grid>
    </DataTemplate>
    <!-- 中アイコン以上(名前は下) -->
    <DataTemplate x:Key="TileTemplateVertical">
        <StackPanel>
            <controls:Rubbernail Item="{Binding}" Margin="0,0,0,4"
                                 Width="{Binding (controls:TileMetrics.IconSize), RelativeSource={RelativeSource AncestorType=ListView}}"
                                 Height="{Binding (controls:TileMetrics.IconSize), RelativeSource={RelativeSource AncestorType=ListView}}"/>
            <TextBlock Text="{Binding Name}" ToolTip="{Binding Name}"
                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListViewItem}}"
                       TextTrimming="CharacterEllipsis" TextAlignment="Center"/>
        </StackPanel>
    </DataTemplate>

    <!-- サムネ付きリストのファイル名セル -->
    <DataTemplate x:Key="ListThumbCellTemplate">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <controls:Rubbernail Item="{Binding}" Width="24" Height="24" Margin="0,1,6,1"/>
            <TextBlock Grid.Column="1" Text="{Binding Name}"
                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListViewItem}}"
                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
        </Grid>
    </DataTemplate>
</ResourceDictionary>
