<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:controls="clr-namespace:ImooneWPF.Controls">
    <ItemsPanelTemplate x:Key="TilePanelIconS">
        <controls:EssenUndFressenPanel ItemWidth="200" ItemHeight="28"/>
    </ItemsPanelTemplate>
    <ItemsPanelTemplate x:Key="TilePanelIconM">
        <controls:EssenUndFressenPanel ItemWidth="128" ItemHeight="64"/>
    </ItemsPanelTemplate>
    <ItemsPanelTemplate x:Key="TilePanelIconL">
        <controls:EssenUndFressenPanel ItemWidth="144" ItemHeight="96"/>
    </ItemsPanelTemplate>
    <ItemsPanelTemplate x:Key="TilePanelIconH">
        <controls:EssenUndFressenPanel ItemWidth="144" ItemHeight="192"/>
    </ItemsPanelTemplate>
    <DataTemplate x:Key="TileTemplateIconS">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <controls:Rubbernail Item="{Binding}" Width="16" Height="16" Margin="0,0,6,0"/>
            <TextBlock Grid.Column="1" Text="{Binding Name}" ToolTip="{Binding Name}"
                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListViewItem}}"
                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
        </Grid>
    </DataTemplate>
    <DataTemplate x:Key="TileTemplateIconM">
        <StackPanel>
            <controls:Rubbernail Item="{Binding}" Width="32" Height="32" Margin="0,0,0,4"/>
            <TextBlock Text="{Binding Name}" ToolTip="{Binding Name}"
                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListViewItem}}"
                       TextTrimming="CharacterEllipsis" TextAlignment="Center"/>
        </StackPanel>
    </DataTemplate>
    <DataTemplate x:Key="TileTemplateIconL">
        <StackPanel>
            <controls:Rubbernail Item="{Binding}" Width="64" Height="64" Margin="0,0,0,4"/>
            <TextBlock Text="{Binding Name}" ToolTip="{Binding Name}"
                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListViewItem}}"
                       TextTrimming="CharacterEllipsis" TextAlignment="Center"/>
        </StackPanel>
    </DataTemplate>

    <DataTemplate x:Key="TileTemplateIconH">
        <StackPanel>
            <controls:Rubbernail Item="{Binding}" Width="128" Height="128" Margin="0,0,0,4"/>
            <TextBlock Text="{Binding Name}" ToolTip="{Binding Name}"
                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListViewItem}}"
                       TextTrimming="CharacterEllipsis" TextAlignment="Center"/>
        </StackPanel>
    </DataTemplate>

    <!-- サムネ付きリストのファイル名セル -->
    <DataTemplate x:Key="ListThumbCellTemplate">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <controls:Rubbernail Item="{Binding}" Width="24" Height="24" Margin="0,1,6,1"/>
            <TextBlock Grid.Column="1" Text="{Binding Name}"
                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListViewItem}}"
                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
        </Grid>
    </DataTemplate>
</ResourceDictionary>
