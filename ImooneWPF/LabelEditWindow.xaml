<web3:Nuendow x:Class="ImooneWPF.LabelEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ImooneWPF"
        xmlns:modelle="clr-namespace:ImooneWPF.Modelle"
        xmlns:properties="clr-namespace:ImooneWPF.Properties"
        xmlns:web3="clr-namespace:ImogeIndex.Web3;assembly=ImogeIndex.Web3"              
        mc:Ignorable="d"
        Title="{x:Static properties:Resources.LE_LabelEdit}" 
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource WindowForegroundBrush}"
        WindowStyle="ToolWindow"
        Height="450" Width="450">
    <DockPanel>
        <DockPanel DockPanel.Dock="Bottom">
            <Border
            Grid.Row="1"
            Padding="12,12,0,12"
            BorderThickness="0,1,0,0"
            BorderBrush="{DynamicResource ControlBorderBrush}"
            DockPanel.Dock="Bottom">

            <StackPanel
                HorizontalAlignment="Right"
                Orientation="Horizontal">

                <Button
                    MinWidth="90"
                    Margin="0,0,8,0"
                    Content="{x:Static properties:Resources.LE_Save}"
                    Command="{Binding OkCommand}" 
                    CommandParameter="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=Window}}"/>

                <Button
                    MinWidth="90"
                    Margin="0,0,8,0"
                    Content="{x:Static properties:Resources.LE_Cancel}"
                    Command="{Binding CancelCommand}"
                    CommandParameter="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=Window}}"
                    IsCancel="True" />
            </StackPanel>
            </Border>
        </DockPanel>

        <DockPanel Margin="4">
            <StackPanel DockPanel.Dock="Top">
                <TextBlock Text="{x:Static properties:Resources.LE_InputHint}"/>
                <!-- エラーメッセージ置き場 -->
                <ItemsControl ItemsSource="{Binding (Validation.Errors), ElementName=LabelsText}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding ErrorContent}" Foreground="Red" FontSize="11" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
            <TextBox x:Name="LabelsText" AcceptsReturn="True" FontFamily="MS Gothic" 
                    Text="{Binding Labels,
                        UpdateSourceTrigger=PropertyChanged,
                        ValidatesOnNotifyDataErrors=True}"/>
        </DockPanel>
    </DockPanel>
</web3:Nuendow>
